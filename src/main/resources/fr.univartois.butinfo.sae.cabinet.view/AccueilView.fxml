<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>


<VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.AccueilController">

    <Label text="Système de Gestion - Cabinet Médical" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <Button text="Gestion des Patients" onAction="#ouvrirGestionPatients" prefWidth="250" style="-fx-font-size: 14px; -fx-padding: 10;" />
    <Button text="Gestion des Médecins" onAction="#ouvrirGestionMedecins" prefWidth="250" style="-fx-font-size: 14px; -fx-padding: 10;" />
    <Button text="Gestion des Médicaments" onAction="#ouvrirGestionMedicaments" prefWidth="250" style="-fx-font-size: 14px; -fx-padding: 10;" />
    <Button text="Gestion des Rendez-vous" onAction="#ouvrirGestionRdv" prefWidth="250" style="-fx-font-size: 14px; -fx-padding: 10;" />
    <Button text="Gestion des Ordonnances" onAction="#ouvrirGestionOrdonnances" prefWidth="250" style="-fx-font-size: 14px; -fx-padding: 10;" />

</VBox>