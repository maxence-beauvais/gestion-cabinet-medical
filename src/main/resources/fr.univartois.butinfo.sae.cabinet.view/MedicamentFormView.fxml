<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedicamentFormController">
    <TextField fx:id="txtNom" promptText="Nom du médicament" />
    <TextField fx:id="txtDesc" promptText="Description" />
    <TextField fx:id="txtPrix" promptText="Prix" />
    <HBox spacing="20"><Button text="Valider" onAction="#valider" /><Button text="Annuler" onAction="#annuler" /></HBox>
</VBox>