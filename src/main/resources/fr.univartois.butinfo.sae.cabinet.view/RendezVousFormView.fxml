<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.RendezVousFormController">
    <ComboBox fx:id="comboPatient" promptText="Sélectionner le patient" />
    <ComboBox fx:id="comboMedecin" promptText="Sélectionner le médecin" />
    <TextField fx:id="txtDate" promptText="Date et Heure (Ex: 2025-10-15T14:30)" />
    <TextField fx:id="txtMotif" promptText="Motif de consultation" />
    <HBox spacing="20"><Button text="Valider" onAction="#valider" /><Button text="Annuler" onAction="#annuler" /></HBox>
</VBox>