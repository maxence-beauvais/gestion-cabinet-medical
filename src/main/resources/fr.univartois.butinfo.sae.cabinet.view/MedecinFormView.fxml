<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.MedecinFormController">
    <Label text="Formulaire Médecin" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <TextField fx:id="txtNom" promptText="Nom" />
    <TextField fx:id="txtPrenom" promptText="Prénom" />
    <TextField fx:id="txtOrdre" promptText="Numéro d'Ordre" />
    <ComboBox fx:id="comboSpecialite" promptText="Sélectionner une spécialité" prefWidth="200" />
    <TextField fx:id="txtTarif" promptText="Tarif consultation (€)" />
    <HBox spacing="20">
        <Button text="Valider" onAction="#valider" />
        <Button text="Annuler" onAction="#annuler" />
    </HBox>
</VBox>