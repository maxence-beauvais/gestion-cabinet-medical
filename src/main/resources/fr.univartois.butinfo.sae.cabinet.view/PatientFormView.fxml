<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>


<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univartois.butinfo.sae.cabinet.controller.PatientFormController">
    <Label text="Formulaire Patient" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <TextField fx:id="txtNom" promptText="Nom" />
    <TextField fx:id="txtPrenom" promptText="Prénom" />
    <TextField fx:id="txtSecu" promptText="Numéro de Sécurité Sociale" />
    <HBox spacing="20">
        <Button text="Valider" onAction="#valider" />
        <Button text="Annuler" onAction="#annuler" />
    </HBox>
</VBox>